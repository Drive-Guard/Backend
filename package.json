{
  "name": "driveguard-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API da dashboard e trabalhos agendados do DriveGuard (AWS Lambda + TypeScript + osls)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "node scripts/db-local.mjs",
    "db:migrar": "tsx scripts/migrar.ts",
    "db:resemear": "tsx scripts/migrar.ts --resemear",
    "dev:api": "tsx scripts/dev-api.ts",
    "print": "osls print --stage dev",
    "deploy": "npm run build && osls deploy --stage dev",
    "remove": "osls remove --stage dev"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-sesv2": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@serverless/typescript": "^4.30.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "embedded-postgres": "^16.14.0-beta.17",
    "esbuild": "^0.28.2",
    "osls": "^4.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@16.14.0-beta.17": true,
    "es5-ext": false
  }
}
